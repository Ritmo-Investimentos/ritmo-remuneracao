{
  "hosting": {
    "site": "remuneracao-ritmo-investimentos",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "iniciar-servidor.ps1",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
